    </div>
  </div>
</div>

<!-- Bootstrap JS + jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
  $(document).ready(function () {
    // Staff page visit count track करतो
    let visitCount = localStorage.getItem("staffPageVisits") || 0;
    visitCount++;
    localStorage.setItem("staffPageVisits", visitCount);

    // Delay ठरवतो → 1st time = 4s, 2nd+ = 10s
    let delayTime = (visitCount == 1) ? 4000 : 10000;

    // Delay नंतर registration modal auto open
    setTimeout(() => {
      var modal = new bootstrap.Modal(document.getElementById('registerModal'));
      modal.show();
    }, delayTime);
    
    // Scroll animations
    function checkScroll() {
      // Section animations
      $('.section').each(function() {
        var position = $(this).offset().top;
        var scroll = $(window).scrollTop();
        var windowHeight = $(window).height();
        
        if (scroll > position - windowHeight + 100) {
          $(this).addClass('visible');
        }
      });
      
      // Feature card animations
      $('.feature-card').each(function() {
        var position = $(this).offset().top;
        var scroll = $(window).scrollTop();
        var windowHeight = $(window).height();
        
        if (scroll > position - windowHeight + 100) {
          $(this).addClass('visible');
        }
      });
      
      // About content animation
      $('.about-content').each(function() {
        var position = $(this).offset().top;
        var scroll = $(window).scrollTop();
        var windowHeight = $(window).height();
        
        if (scroll > position - windowHeight + 100) {
          $(this).addClass('visible');
        }
      });
      
      // About image animation
      $('.about-image').each(function() {
        var position = $(this).offset().top;
        var scroll = $(window).scrollTop();
        var windowHeight = $(window).height();
        
        if (scroll > position - windowHeight + 100) {
          $(this).addClass('visible');
        }
      });
      
      // Benefit items animation
      $('.benefit-item').each(function(i) {
        var position = $(this).offset().top;
        var scroll = $(window).scrollTop();
        var windowHeight = $(window).height();
        
        if (scroll > position - windowHeight + 100) {
          // Stagger the animation for each item
          var $el = $(this);
          setTimeout(function() {
            $el.addClass('visible');
          }, i * 200);
        }
      });
      
      // Stat items animation
      $('.stat-item').each(function() {
        var position = $(this).offset().top;
        var scroll = $(window).scrollTop();
        var windowHeight = $(window).height();
        
        if (scroll > position - windowHeight + 100) {
          $(this).addClass('visible');
          
          // Animate counting numbers
          $('.stat-number').each(function() {
            var $this = $(this);
            var countTo = $this.attr('data-count');
            
            $({ countNum: $this.text() }).animate({
              countNum: countTo
            },
            {
              duration: 2000,
              easing: 'swing',
              step: function() {
                $this.text(Math.floor(this.countNum));
              },
              complete: function() {
                $this.text(this.countNum);
              }
            });
          });
        }
      });
      
      // Contact card animations
      $('.contact-card').each(function() {
        var position = $(this).offset().top;
        var scroll = $(window).scrollTop();
        var windowHeight = $(window).height();
        
        if (scroll > position - windowHeight + 100) {
          $(this).addClass('visible');
        }
      });
    }
    
    // Initial animation check
    checkScroll();
    
    // Animate on scroll
    $(window).scroll(function() {
      checkScroll();
    });
    
    // Button pulse effect
    $('.btn-pulse').on('click', function() {
      $(this).addClass('active');
      setTimeout(() => {
        $(this).removeClass('active');
      }, 1000);
    });
  });
</script>
</body>
</html>