<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invalid Login - MediCare Portal</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary: #2c78e4;
      --primary-dark: #1a5bbd;
      --secondary: #2c3e50;
      --accent: #00b8d4;
      --light: #f8f9fa;
      --dark: #212529;
      --success: #28a745;
      --warning: #ffc107;
      --danger: #dc3545;
      --gradient: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Open Sans', sans-serif;
      background: #f8f9fa;
      color: var(--dark);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><rect width="100" height="100" fill="%23f8f9fa"/><path d="M0 50 L100 50 M50 0 L50 100" stroke="%23e9ecef" stroke-width="2"/></svg>');
      background-size: 30px 30px;
    }

    .error-card {
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
      max-width: 500px;
      width: 100%;
      text-align: center;
      animation: fadeIn 0.6s ease-out;
      position: relative;
    }

    .error-header {
      background: var(--gradient);
      padding: 30px 20px;
      color: white;
    }

    .error-icon {
      font-size: 5rem;
      margin-bottom: 15px;
      animation: pulse 1.5s infinite;
    }

    .error-body {
      padding: 30px;
    }

    h1 {
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      color: var(--secondary);
      margin-bottom: 15px;
    }

    .error-message {
      font-size: 1.2rem;
      color: #6c757d;
      margin-bottom: 30px;
      line-height: 1.6;
    }

    .btn {
      padding: 12px 30px;
      border-radius: 50px;
      font-weight: 600;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
      margin: 5px;
      border: none;
      cursor: pointer;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
      box-shadow: 0 4px 15px rgba(44, 120, 228, 0.3);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(44, 120, 228, 0.4);
    }

    .btn-outline {
      background: transparent;
      color: var(--primary);
      border: 2px solid var(--primary);
    }

    .btn-outline:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-3px);
    }

    .help-links {
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid #eee;
    }

    .help-links a {
      color: var(--primary);
      text-decoration: none;
      transition: all 0.3s ease;
      display: inline-block;
      margin: 0 10px;
    }

    .help-links a:hover {
      color: var(--primary-dark);
      text-decoration: underline;
    }

    /* Animations */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulse {
      0% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.05);
      }
      100% {
        transform: scale(1);
      }
    }

    /* Responsive adjustments */
    @media (max-width: 576px) {
      .error-card {
        margin: 0 15px;
      }
      
      .error-icon {
        font-size: 4rem;
      }
      
      h1 {
        font-size: 1.8rem;
      }
      
      .error-message {
        font-size: 1rem;
      }
      
      .btn {
        padding: 10px 20px;
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>

  <div class="error-card">
    <div class="error-header">
      <i class="fas fa-exclamation-circle error-icon"></i>
      <h1>Invalid Login</h1>
    </div>
    
    <div class="error-body">
      <p class="error-message">The email or password you entered is incorrect. Please try again or reset your password.</p>
      
      <div class="action-buttons">
        <a href="/" class="btn btn-primary">
          <i class="fas fa-sign-in-alt me-2"></i>Back to Login
        </a>
        <a href="register.html" class="btn btn-outline">
          <i class="fas fa-user-plus me-2"></i>Register
        </a>
      </div>
      
      <div class="help-links">
        <p>Need help? Contact our support team:</p>
        <p>
          <a href="mailto:support@medicare.com">
            <i class="fas fa-envelope me-1"></i>support@medicare.com
          </a>
          <a href="tel:+919876543210">
            <i class="fas fa-phone me-1"></i>+91 9876543210
          </a>
        </p>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>