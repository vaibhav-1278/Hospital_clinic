<%-include('navbar.ejs')%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Doctor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Dashboard Container -->
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <!-- Card -->
                <div class="card shadow-lg border-0 rounded-3">
                    <div class="card-header bg-primary text-white text-center">
                        <h4 class="mb-0">Edit Doctor</h4>
                    </div>
                    <div class="card-body p-4">
                        <form action="/update_doctor" method="post">
                            <input type="hidden" name="doctor_id" value="<%= doctor.doctor_id %>">

                            <!-- Doctor Name -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Doctor Name</label>
                                <input type="text" name="doctor_name" class="form-control" value="<%= doctor.doctor_name %>" required>
                            </div>

                            <!-- Specialization -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Specialization</label>
                                <input type="text" name="doctor_specialization" class="form-control" value="<%= doctor.doctor_specialization %>" required>
                            </div>

                            <!-- In Time -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">In Time</label>
                                <input type="time" name="doctor_in_time" class="form-control" value="<%= doctor.doctor_in_time %>" required>
                            </div>

                            <!-- Out Time -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Out Time</label>
                                <input type="time" name="doctor_out_time" class="form-control" value="<%= doctor.doctor_out_time %>" required>
                            </div>

                            <!-- Avg Checkup Time -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Avg. Checkup (Minutes)</label>
                                <input type="number" name="avg_checkup_minutes" class="form-control" value="<%= doctor.avg_checkup_minutes %>" min="1" required>
                            </div>

                            <!-- Submit Button -->
                            <div class="d-grid">
                                <button class="btn btn-primary btn-lg">Update Doctor</button>
                            </div>

                        </form>
                    </div>
                </div>
                <!-- End Card -->

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<%-include('footer.ejs')%>