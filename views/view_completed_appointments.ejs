<%- include('navbar.ejs') %>

<div class="container mt-5">
    <div class="dashboard-card p-4 mb-4">
        <h2 class="mb-4">✅ Completed Appointments</h2>
 <div class="doctor-links mb-4">
            <% for(var i = 0; i < doctors.length; i++) { %>
                <a href="/view_completed_appointments?doctor_id=<%= doctors[i].doctor_id %>" class="dashboard-btn">
                    <%= doctors[i].doctor_name %>  (<%= doctors[i].total %>)
                </a>
            <% } %>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover completed-table">
                <thead>
                    <tr>
                        <th>Sr No</th>
                        <th>Doctor Name</th>
                        <th>Patient Name</th>
                        <th>Patient Mobile</th>
                        <th>Appointment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(var i = 0; i < appointments.length; i++) { 
                        var a = appointments[i]; %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><%= a.doctor_name %></td>
                        <td><%= a.patient_name %></td>
                        <td><%= a.patient_mobile %></td>
                        <td><%= a.appointment_date.toISOString().split('T')[0] %></td>
                        <td><span class="status-completed"><%= a.appointment_status %></span></td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <a href="/view_appointments" class="dashboard-btn mt-4">&#8592; Back to All Appointments</a>
    </div>
</div>

<style>
body {
    background: #f0f2f5;
    font-family: 'Segoe UI', sans-serif;
}

.dashboard-card {
    background: #fff;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
}

/* Completed Appointments Table */
.completed-table thead {
    background: linear-gradient(90deg, #198754 0%, #20c997 100%);
    color: #fff;
    font-size: 1.1rem;
}

.completed-table th {
    text-align: center;
    font-weight: 600;
    border-bottom: 2px solid #20c997;
}

.completed-table tbody tr {
    background-color: #f8f9fa;
    transition: background 0.2s;
}

.completed-table tbody tr:hover {
    background-color: #e6f4ea;
}

.completed-table td {
    text-align: center;
    font-size: 1rem;
    color: #333;
}

.status-completed {
    display: inline-block;
    background: #28a745;
    color: #fff;
    padding: 0.3em 0.7em;
    border-radius: 12px;
    font-weight: 600;
}

/* Back Button */
.dashboard-btn {
    display: inline-block;
    background: linear-gradient(90deg, #28a745 0%, #20c997 100%);
    color: #fff;
    padding: 0.6em 1.5em;
    border-radius: 25px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: background 0.3s, box-shadow 0.3s, transform 0.2s;
}

.dashboard-btn:hover {
    background: linear-gradient(90deg, #218838 0%, #17a2b8 100%);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    transform: translateY(-2px);
}
</style>

<%- include('footer.ejs') %>
