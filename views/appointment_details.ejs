<%- include('navbar.ejs') %>

<div class="container mt-5">
    <div class="dashboard-card p-4 mb-4">
        <h2 class="mb-4">Appointment Details</h2>

        <style>
            .appointment-table thead {
                background: linear-gradient(90deg, #0052cc 0%, #00b8d9 100%);
                color: #fff;
                font-size: 1.1rem;
            }
            .appointment-table th {
                text-align: center;
                letter-spacing: 1px;
                font-weight: 600;
                border-bottom: 2px solid #00b8d9;
            }
            .appointment-table tbody tr {
                background-color: #f8f9fa;
                transition: background 0.2s;
            }
            .appointment-table tbody tr:hover {
                background-color: #e3f2fd;
            }
            .appointment-table td {
                text-align: center;
                color: #333;
                font-size: 1rem;
            }
        </style>

        <!-- Appointment Details Table -->
        <table class="table table-striped table-bordered table-hover appointment-table">
            <thead>
                <tr>
                    <th>Doctor Name</th>
                    <th>Patient Name</th>
                    <th>Mobile</th>
                    <th>Address</th>
                    <th>Disease Note</th>
                    <th>Appointment Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><%= appointment.doctor_name %></td>
                    <td><%= appointment.patient_name %></td>
                    <td><%= appointment.patient_mobile %></td>
                    <td><%= appointment.patient_address %></td>
                    <td><%= appointment.patient_disease_note %></td>
                    <td><%= new Date(appointment.appointment_date).toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}) %></td>
                </tr>
            </tbody>
        </table>

        <!-- Complete Appointment Form -->
        <form action="/complete_appointment" method="post" class="mt-4">
            <input type="hidden" name="appointment_id" value="<%= appointment.appointment_id %>">

            <!-- First row (4 fields in one line) -->
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Start Time</label>
                    <input type="time" class="form-control" name="appointment_start_time" id="start_time" value="<%= appointment.appointment_start_time %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">End Time</label>
                    <input type="time" class="form-control" name="appointment_end_time" id="end_time" value="<%= appointment.appointment_end_time %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Patient Age</label>
                    <input type="text" class="form-control" name="patient_age" id="patient_age" value="<%= appointment.patient_age %>">
                </div>
               <div class="col-md-3">
    <label class="form-label">Patient Gender</label>
    <select class="form-select" name="patient_gender">
        <option value="Male" <%= appointment.patient_gender === 'Male' ? 'selected' : '' %>>Male</option>
        <option value="Female" <%= appointment.patient_gender === 'Female' ? 'selected' : '' %>>Female</option>
        <option value="Other" <%= appointment.patient_gender === 'Other' ? 'selected' : '' %>>Other</option>
    </select>
</div>
</div>

            <!-- Second row (prescription full width) -->
           <div class="row g-3 mt-3">
    <div class="col-12">
        <label class="form-label">Prescription</label>
        <textarea class="form-control" name="prescription" id="prescription" rows="3"><%= appointment.prescription %></textarea>
    </div>
</div>


            <button type="submit" class="dashboard-btn mt-4">
                <i class="fas fa-check-circle"></i> Complete Appointment
            </button>
        </form>

        <!-- Action Buttons -->
        <a href="/view_appointments" class="dashboard-btn mt-3">&#8592; Back to Appointments</a>
    </div>
</div>

<%- include('footer.ejs') %>
